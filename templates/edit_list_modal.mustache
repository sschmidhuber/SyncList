<div class="modal fade" id="editListModal" tabindex="-1" aria-labelledby="editListModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold" id="editListModalLabel"><i class="bi bi-pencil-fill me-2 text-primary"></i>Rename List</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form hx-post="/lists/{{id}}/edit" hx-target="#lists-container" hx-swap="innerHTML">
                <div class="modal-body pb-0">
                    <div class="mb-3">
                        <label for="edit-list-name" class="form-label fw-bold text-secondary">List Name</label>
                        <input type="text" class="form-control" id="edit-list-name" name="name" value="{{name}}" required autocomplete="off">
                    </div>
                    {{#is_owner}}
                    <div class="mb-3 form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="edit-list-shared" name="is_shared" value="1" {{#is_shared}}checked{{/is_shared}}>
                        <label class="form-check-label text-muted small" for="edit-list-shared">Shared (others can see and collaborate)</label>
                    </div>
                    {{/is_owner}}
                </div>
                <div class="modal-footer border-0 pt-3">
                    <button type="button" class="btn btn-outline-secondary btn-sm px-3" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary btn-sm px-3" data-bs-dismiss="modal"><i class="bi bi-check-lg me-1"></i>Save</button>
                </div>
            </form>
        </div>
    </div>
</div>
<script>
    (function() {
        var modalEl = document.getElementById('editListModal');
        var modal = new bootstrap.Modal(modalEl);
        modal.show();
        modalEl.addEventListener('shown.bs.modal', function () {
            var input = document.getElementById('edit-list-name');
            if (input) {
                input.focus();
                input.select();
            }
        });
    })();
</script>
