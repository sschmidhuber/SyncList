<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SyncList - Admin</title>
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">
    <!-- HTMX -->
    <script src="https://unpkg.com/htmx.org@1.9.10"></script>
    <style>
        body {
            background-color: #f4f6f9;
        }
        .admin-card {
            border: none;
            border-radius: 0.75rem;
            box-shadow: 0 0.25rem 0.5rem rgba(0,0,0,0.05);
            margin-bottom: 1.5rem;
        }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand navbar-dark bg-primary mb-4 shadow-sm">
        <div class="container">
            <span class="navbar-brand mb-0 h1 fw-bold"><i class="bi bi-card-checklist me-2"></i>SyncList</span>
            <div class="d-flex align-items-center">
                <span class="text-white me-3 d-none d-sm-inline">Logged in as <strong>{{username}}</strong></span>
                <a href="/lists" class="btn btn-light btn-sm me-2"><i class="bi bi-house-door me-1"></i>Dashboard</a>
                <a href="/logout" class="btn btn-outline-light btn-sm">Sign Out</a>
            </div>
        </div>
    </nav>

    <div class="container px-3 pb-5" style="max-width: 600px;">
        <div class="card admin-card">
            <div class="card-header bg-white py-3 border-0" style="border-top-left-radius: 0.75rem; border-top-right-radius: 0.75rem;">
                <h5 class="mb-0 fw-bold"><i class="bi bi-gear-fill text-primary me-2"></i>Autosuggestion Admin</h5>
            </div>
            
            <div class="card-body">
                <!-- Add Suggestion Form -->
                <form action="/admin/suggestions" method="POST" class="mb-4">
                    <div class="input-group">
                        <input type="text" name="name" class="form-control" placeholder="Add new grocery / item..." required autocomplete="off">
                        <button class="btn btn-primary" type="submit"><i class="bi bi-plus-lg me-1"></i>Add</button>
                    </div>
                </form>

                <!-- Suggestions List -->
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th class="text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            {{#suggestions}}
                            <tr>
                                <td>{{name}}</td>
                                <td class="text-end">
                                    <button hx-delete="/admin/suggestions/{{id}}" hx-target="body" class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-trash"></i> Delete
                                    </button>
                                </td>
                            </tr>
                            {{/suggestions}}
                            {{^suggestions}}
                            <tr>
                                <td colspan="2" class="text-center text-muted py-3">No suggestions found. Add one above!</td>
                            </tr>
                            {{/suggestions}}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Bootstrap Bundle JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
