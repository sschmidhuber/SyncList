<div class="modal fade" id="deleteListModal" tabindex="-1" aria-labelledby="deleteListModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold" id="deleteListModalLabel"><i class="bi bi-exclamation-triangle-fill me-2 text-danger"></i>Delete List</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                Are you sure you want to delete the list <strong>{{name}}</strong>? This will permanently remove all of its items.
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-outline-secondary btn-sm px-3" data-bs-dismiss="modal">Cancel</button>
                <button hx-delete="{{base_path}}/lists/{{id}}" hx-target="#lists-container" hx-swap="innerHTML" class="btn btn-danger btn-sm px-3" data-bs-dismiss="modal"><i class="bi bi-trash me-1"></i>Delete</button>
            </div>
        </div>
    </div>
</div>
<script>
    (function() {
        var modalEl = document.getElementById('deleteListModal');
        var modal = new bootstrap.Modal(modalEl);
        modal.show();
    })();
</script>
