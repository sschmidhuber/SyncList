{{^fragment}}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SyncList</title>
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">
    <!-- HTMX -->
    <script src="https://unpkg.com/htmx.org@1.9.10"></script>
    <script src="https://unpkg.com/htmx.org@1.9.10/dist/ext/sse.js"></script>
    <!-- SortableJS -->
    <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.0/Sortable.min.js"></script>
    <style>
        body {
            background-color: #f4f6f9;
        }
        .list-card {
            border: none;
            border-radius: 0.75rem;
            box-shadow: 0 0.25rem 0.5rem rgba(0,0,0,0.05);
            margin-bottom: 1.5rem;
        }
        .item-done {
            text-decoration: line-through;
            color: #6c757d;
        }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand navbar-dark bg-primary mb-4 shadow-sm">
        <div class="container">
            <span class="navbar-brand mb-0 h1 fw-bold"><i class="bi bi-card-checklist me-2"></i>SyncList</span>
            <div class="d-flex align-items-center">
                <span class="text-white me-3 d-none d-sm-inline">Logged in as <strong>{{username}}</strong></span>
                <button type="button" class="btn btn-light btn-sm me-3" data-bs-toggle="modal" data-bs-target="#newListModal">
                    <i class="bi bi-plus-lg me-1"></i>New List
                </button>
                <a href="/logout" class="btn btn-outline-light btn-sm">Sign Out</a>
            </div>
        </div>
    </nav>

    <div class="container px-3 pb-5" style="max-width: 800px;" hx-ext="sse" sse-connect="/lists/events">
        <!-- Lists Container -->
        <div id="lists-container" hx-get="/lists/content" hx-trigger="sse:list-updated" hx-swap="innerHTML">
{{/fragment}}

            {{#lists}}
            <div class="card list-card">
                <div class="card-header bg-white d-flex justify-content-between align-items-center py-3 border-0" style="border-top-left-radius: 0.75rem; border-top-right-radius: 0.75rem;">
                    <div>
                        <h5 class="mb-0 fw-bold d-inline-block align-middle me-2">{{name}}</h5>
                        {{#is_shared}}
                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill align-middle small"><i class="bi bi-people-fill me-1"></i>Shared</span>
                        {{/is_shared}}
                        {{^is_shared}}
                        <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-pill align-middle small"><i class="bi bi-lock-fill me-1"></i>Private</span>
                        {{/is_shared}}
                        <span class="text-muted d-block small mt-1">Owner: {{owner}}</span>
                    </div>
                    <div class="btn-group">
                        <button hx-post="/lists/{{id}}/toggle_hidden" hx-target="#lists-container" hx-swap="innerHTML"
                                class="btn btn-sm btn-outline-secondary border-0"
                                data-bs-toggle="tooltip" data-bs-placement="top"
                                title="{{#show_hidden}}Hide completed items{{/show_hidden}}{{^show_hidden}}Show hidden completed items{{/show_hidden}}">
                            {{#show_hidden}}
                            <i class="bi bi-eye"></i>
                            {{/show_hidden}}
                            {{^show_hidden}}
                            <i class="bi bi-eye-slash"></i>
                            {{/show_hidden}}
                        </button>
                        <button hx-get="/lists/{{id}}/edit" hx-target="#modals-holder" 
                                class="btn btn-sm btn-outline-secondary border-0"
                                data-bs-toggle="tooltip" data-bs-placement="top" title="Rename List">
                            <i class="bi bi-pencil"></i>
                        </button>
                        <button hx-get="/lists/{{id}}/delete" hx-target="#modals-holder" 
                                class="btn btn-sm btn-outline-danger border-0"
                                data-bs-toggle="tooltip" data-bs-placement="top" title="Delete List">
                            <i class="bi bi-trash"></i>
                        </button>
                    </div>
                </div>
                
                <div class="card-body pt-0">
                    <!-- Add Item Form inside list -->
                    <form hx-post="/lists/{{id}}/items" hx-target="#lists-container" hx-swap="innerHTML" class="mb-3">
                        <div class="input-group input-group-sm">
                            <input type="text" class="form-control" id="add-item-{{id}}" name="name" placeholder="Add new item..." required autocomplete="off" hx-preserve>
                            <button class="btn btn-primary" type="submit"><i class="bi bi-plus-lg"></i></button>
                        </div>
                    </form>

                    <!-- Items List -->
                    <ul class="sortable-list list-group list-group-flush border-top" data-list-id="{{id}}">
                        {{#items}}
                        <li class="sortable-item list-group-item d-flex justify-content-between align-items-center px-0 py-2 border-0 border-bottom" data-item-id="{{id}}">
                            <div class="d-flex align-items-center">
                                <i class="bi bi-grip-vertical text-muted drag-handle me-1" style="cursor: grab; font-size: 1.1rem;"></i>
                                <div class="form-check mb-0">
                                    <input class="form-check-input me-2" type="checkbox" id="item-chk-{{id}}" 
                                           hx-post="/items/{{id}}/toggle" hx-target="#lists-container" hx-swap="innerHTML"
                                           {{#is_done}}checked{{/is_done}}>
                                    <label class="form-check-label {{#is_done}}item-done{{/is_done}}" for="item-chk-{{id}}">
                                        {{name}}
                                    </label>
                                </div>
                            </div>
                            <div class="btn-group">
                                <button hx-get="/items/{{id}}/edit" hx-target="#modals-holder" class="btn btn-sm btn-link text-secondary p-1"><i class="bi bi-pencil-square"></i></button>
                                <button hx-delete="/items/{{id}}" hx-target="#lists-container" hx-swap="innerHTML" class="btn btn-sm btn-link text-danger p-1"><i class="bi bi-x-circle"></i></button>
                            </div>
                        </li>
                        {{/items}}
                        {{^items}}
                        <li class="list-group-item text-center text-muted py-3 border-0 bg-transparent small">No items yet. Add one above!</li>
                        {{/items}}
                    </ul>
                </div>
            </div>
            {{/lists}}
            {{^lists}}
            <div class="text-center py-5">
                <i class="bi bi-card-list text-muted display-4"></i>
                <h5 class="mt-3 text-muted">No lists available</h5>
                <p class="text-muted small">Create a new list above to get started!</p>
            </div>
            {{/lists}}

{{^fragment}}
        </div>
    </div>

    <!-- New List Modal -->
    <div class="modal fade" id="newListModal" tabindex="-1" aria-labelledby="newListModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold" id="newListModalLabel"><i class="bi bi-plus-circle-fill me-2 text-primary"></i>Create New List</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form hx-post="/lists" hx-target="#lists-container" hx-swap="innerHTML" hx-on::after-request="this.reset()">
                    <div class="modal-body pb-0">
                        <div class="mb-3">
                            <label for="new-list-name" class="form-label fw-bold text-secondary">List Name</label>
                            <input type="text" class="form-control" id="new-list-name" name="name" placeholder="List Name (e.g. Grocery Shop)" required autocomplete="off">
                        </div>
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="new-list-shared" name="is_shared" value="1" checked>
                            <label class="form-check-label text-muted small" for="new-list-shared">Shared (others can see and collaborate)</label>
                        </div>
                    </div>
                    <div class="modal-footer border-0 pt-3">
                        <button type="button" class="btn btn-outline-secondary btn-sm px-3" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary btn-sm px-3" data-bs-dismiss="modal"><i class="bi bi-plus-lg me-1"></i>Create</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div id="modals-holder"></div>

    <!-- Bootstrap Bundle JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Autofocus the list name field when the modal is shown
        const newListModal = document.getElementById('newListModal');
        if (newListModal) {
            newListModal.addEventListener('shown.bs.modal', () => {
                const input = document.getElementById('new-list-name');
                if (input) input.focus();
            });
        }

        // Initialize/refresh Bootstrap tooltips
        function initTooltips() {
            // Hide/dispose any active/open tooltip container elements to prevent lingering popups
            const activeTooltips = document.querySelectorAll('.tooltip');
            activeTooltips.forEach(el => el.remove());

            const tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            tooltipTriggerList.forEach(function (tooltipTriggerEl) {
                // If there is an existing instance, dispose it first to avoid memory leaks or duplicate popups
                const existing = bootstrap.Tooltip.getInstance(tooltipTriggerEl);
                if (existing) {
                    existing.dispose();
                }
                new bootstrap.Tooltip(tooltipTriggerEl);
            });
        }

        function initSortable() {
            document.querySelectorAll('.sortable-list').forEach(function(el) {
                if (el.sortableInstance) {
                    el.sortableInstance.destroy();
                }
                el.sortableInstance = new Sortable(el, {
                    animation: 150,
                    handle: '.drag-handle',
                    ghostClass: 'bg-light',
                    onEnd: function (evt) {
                        const listId = el.getAttribute('data-list-id');
                        const itemIds = Array.from(el.querySelectorAll('.sortable-item')).map(item => item.getAttribute('data-item-id')).join(',');
                        
                        const params = new URLSearchParams();
                        params.append('ids', itemIds);
                        
                        fetch('/lists/' + listId + '/reorder', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/x-www-form-urlencoded',
                            },
                            body: params.toString()
                        });
                    }
                });
            });
        }

        document.addEventListener('DOMContentLoaded', function() {
            initTooltips();
            initSortable();
        });
        
        document.body.addEventListener('htmx:afterSwap', function() {
            initTooltips();
            initSortable();
        });

        // Clear and focus "add new item..." textbox after successfully adding an item
        document.body.addEventListener('htmx:afterRequest', function(evt) {
            if (evt.detail.successful) {
                const path = evt.detail.pathInfo ? evt.detail.pathInfo.requestPath : '';
                const hxPost = evt.detail.elt ? evt.detail.elt.getAttribute('hx-post') : '';
                const targetPath = path || hxPost || '';
                const match = targetPath.match(/\/lists\/(\d+)\/items/);
                if (match) {
                    const listId = match[1];
                    setTimeout(function() {
                        const input = document.getElementById('add-item-' + listId);
                        if (input) {
                            input.value = '';
                            input.focus();
                        }
                    }, 50);
                }
            }
        });
    </script>
</body>
</html>
{{/fragment}}
