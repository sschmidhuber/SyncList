<div class="modal fade" id="editItemModal" tabindex="-1" aria-labelledby="editItemModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold" id="editItemModalLabel"><i class="bi bi-pencil-fill me-2 text-primary"></i>Rename Item</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form hx-post="/items/{{id}}/edit" hx-target="#lists-container" hx-swap="innerHTML">
                <div class="modal-body pb-0">
                    <div class="mb-3">
                        <label for="edit-item-name" class="form-label fw-bold text-secondary">Item Name</label>
                        <input type="text" class="form-control" id="edit-item-name" name="name" value="{{name}}" required autocomplete="off">
                    </div>
                </div>
                <div class="modal-footer border-0 pt-3">
                    <button type="button" class="btn btn-outline-secondary btn-sm px-3" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary btn-sm px-3" data-bs-dismiss="modal"><i class="bi bi-check-lg me-1"></i>Save</button>
                </div>
            </form>
        </div>
    </div>
</div>
<script>
    (function() {
        var modalEl = document.getElementById('editItemModal');
        var modal = new bootstrap.Modal(modalEl);
        modal.show();
        modalEl.addEventListener('shown.bs.modal', function () {
            var input = document.getElementById('edit-item-name');
            if (input) {
                input.focus();
                input.select();
            }
        });
    })();
</script>
